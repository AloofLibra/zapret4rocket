--skip --filter-tcp=80 --filter-l7=http
--hostlist-exclude=/opt/zapret2/lists/netrogat.txt
--payload=http_req
--out-range=-n19
--lua-desync=circular_locked:key=9:allow_nohost=1
--lua-desync=http_hostcase:spell=hoSt:strategy=1 --lua-desync=http_domcase:strategy=1
