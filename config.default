--lua-desync=fake:blob=discord_fake:ipfrag_pos_udp=8:ipfrag_disorder:repeats=8:out_range=-d5:strategy=32

--new

#Стратегии для игрового UDP. Широкий диапазон портов для BF, FIFA/FC и похожих игр
--skip --filter-udp=1026-65531
--hostlist-exclude=/opt/zapret2/lists/netrogat.txt
--lua-desync=circular_locked:key=7:allow_nohost=1
