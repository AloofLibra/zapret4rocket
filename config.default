--lua-desync=fake:blob=0x0F0F0F0F:tcp_seq=0:tcp_ack=-66000:badsum:tls_mod=none:strategy=22
--lua-desync=fakeddisorder:pos=10,midsld:seqovl=336:seqovl_pattern=maxru:pattern=google_www:tcp_seq=0:tcp_ack=-66000:badsum:strategy=22
--lua-desync=multisplit:pos=1,sniext+1:seqovl=1:strategy=23


--new

