# this file is included from init scripts
# change values here

# can help in case /tmp has not enough space
#TMPDIR=@/opt/zapret2/tmp

# redefine user for zapret daemons. required on Keenetic
WS_USER=nobody

# override firewall type : iptables,nftables,ipfw
FWTYPE=iptables
# nftables only : set this to 0 to use pre-nat mode. default is post-nat.
# pre-nat mode disables some bypass techniques for forwarded traffic but allows to see client IP addresses in debug log
#POSTNAT=0

# options for ipsets
# maximum number of elements in sets. also used for nft sets
SET_MAXELEM=522288
# too low hashsize can cause memory allocation errors on low RAM systems , even if RAM is enough
# too large hashsize will waste lots of RAM
IPSET_OPT="hashsize 262144 maxelem $SET_MAXELEM"
# dynamically generate additional ip. $1 = ipset/nfset/table name
#IPSET_HOOK="/etc/zapret2.ipset.hook"

# options for ip2net. "-4" or "-6" auto added by ipset create script
IP2NET_OPT4="--prefix-length=22-30 --v4-threshold=3/4"
IP2NET_OPT6="--prefix-length=56-64 --v6-threshold=5"
# options for auto hostlist
# NOTE : in order for these adjustment to work it's required to redirect enough starting packets
# NOTE : set PKT_IN, PKT_OUT variables appropriately
AUTOHOSTLIST_INCOMING_MAXSEQ=4096
AUTOHOSTLIST_RETRANS_MAXSEQ=32768
AUTOHOSTLIST_RETRANS_RESET=1
AUTOHOSTLIST_RETRANS_THRESHOLD=3
AUTOHOSTLIST_FAIL_THRESHOLD=3
AUTOHOSTLIST_FAIL_TIME=60
AUTOHOSTLIST_UDP_IN=1
AUTOHOSTLIST_UDP_OUT=4
# 1 = debug autohostlist positives to ipset/zapret-hosts-auto-debug.log
AUTOHOSTLIST_DEBUGLOG=0

# number of parallel threads for domain list resolves
MDIG_THREADS=30

# ipset/*.sh can compress large lists
GZIP_LISTS=1
# command to reload ip/host lists after update
# comment or leave empty for auto backend selection : ipset or ipfw if present
# on BSD systems with PF no auto reloading happens. you must provide your own command
# set to "-" to disable reload
#LISTS_RELOAD="pfctl -f /etc/pf.conf"

# mark bit used by nfqws to prevent loop
DESYNC_MARK=0x40000000
DESYNC_MARK_POSTNAT=0x20000000

# do not pass outgoing traffic to tpws/nfqws not marked with this bit
# this setting allows to write your own rules to limit traffic that should be fooled
# for example based on source IP or incoming interface name
# no filter if not defined
#FILTER_MARK=0x10000000


NFQWS2_ENABLE=1
# redirect outgoing traffic with connbytes limiter applied in both directions.
NFQWS2_PORTS_TCP=80,443,2053,2083,2087,2096,8443
NFQWS2_PORTS_UDP=443,2053,2083,2087,2096,8443,50000-50099,1400,3478-3481,5349,19294-19344
# PKT_OUT means connbytes dir original
# PKT_IN means connbytes dir reply
NFQWS2_TCP_PKT_OUT=20
NFQWS2_TCP_PKT_IN=10
NFQWS2_UDP_PKT_OUT=5
NFQWS2_UDP_PKT_IN=3
# redirect outgoing traffic without connbytes limiter and incoming with connbytes limiter
# normally it's needed only for stateless DPI that matches every packet in a single TCP session
# typical example are plain HTTP keep alives
# this mode can be very CPU consuming. enable with care !
#NFQWS2_PORTS_TCP_KEEPALIVE=80
#NFQWS2_PORTS_UDP_KEEPALIVE=
# use <HOSTLIST> and <HOSTLIST_NOAUTO> placeholders to engage standard hostlists and autohostlist in ipset dir
# hostlist markers are replaced to empty string if MODE_FILTER does not satisfy
# <HOSTLIST_NOAUTO> appends ipset/zapret-hosts-auto.txt as normal list
NFQWS2_OPT="

--lua-init=@/opt/zapret2/lua/locked.lua
--lua-init=@/opt/zapret2/lua/rst-guard.lua
--blob=maxru:@/opt/zapret2/files/fake/tls_clienthello_max_ru.bin
--blob=google_www:@/opt/zapret2/files/fake/tls_clienthello_www_google_com.bin
--blob=tls4:@/opt/zapret2/files/fake/tls_clienthello_4.bin
--blob=custom:@/opt/zapret2/files/fake/custom_tls.bin
--blob=tls5:@/opt/zapret2/files/fake/tls_clienthello_5.bin
--blob=quic_google:@/opt/zapret2/files/fake/quic_initial_www_google_com.bin
--blob=quic5:@/opt/zapret2/files/fake/quic_5.bin
--blob=discord_fake:@/opt/zapret2/files/fake/quic_initial_dbankcloud_ru.bin
--blob=stun_fake:@/opt/zapret2/files/fake/stun.bin
--blob=blob_rdp:@/opt/zapret2/files/fake/rdp.bin
--blob=discord_udp_1:
--blob=discord_udp_2:
# Общий TCP TLS шаблон на базе блока YT. Содержит range/payload для lua-desync.
--template=z2r_tcp_tls_common
--out-range=-s34228
--in-range=x
--payload=tls_client_hello
--lua-desync=fake:blob=fake_default_tls:tcp_ts=-1000:repeats=2:strategy=1 --lua-desync=multisplit:pos=1,midsld:strategy=1
--lua-desync=multisplit:blob=fake_default_tls:tcp_ts=-500:pos=2:nodrop:strategy=2
--lua-desync=multisplit:blob=fake_default_tls:tcp_ts=-500:pos=2:nodrop:strategy=3 --lua-desync=fakeddisorder:pos=midsld:tcp_ts=-500:strategy=3
--lua-desync=multisplit:blob=fake_default_tls:tcp_ts=-1000:pos=2:nodrop:strategy=4 --lua-desync=fakeddisorder:pos=sniext+4:tcp_ts=-1000:strategy=4
--lua-desync=multisplit:blob=fake_default_tls:tcp_ts=-1000:pos=2:nodrop:strategy=5 --lua-desync=fakeddisorder:pos=midsld:tcp_ts=-1000:strategy=5
--lua-desync=multisplit:blob=fake_default_tls:tcp_ts=-1000:pos=1,2,3:nodrop:strategy=6 --lua-desync=fakeddisorder:pos=sniext+1:tcp_ts=-1000:strategy=6
--lua-desync=multisplit:blob=fake_default_tls:tcp_ts=-1000:pos=1:nodrop:strategy=7 --lua-desync=fakeddisorder:pos=midsld:tcp_ts=-1000:strategy=7
--lua-desync=multisplit:blob=fake_default_tls:tcp_ts=-1000:pos=2:nodrop:strategy=8 --lua-desync=fakeddisorder:pos=midsld:tcp_ts=-1000:strategy=8
--lua-desync=fake:blob=blob_rdp:tcp_ts=-1000:strategy=9 --lua-desync=multidisorder:pos=1,sniext+1,host+1,midsld-2,midsld,midsld+2,endhost-1:strategy=9
--lua-desync=multisplit:blob=fake_default_tls:tcp_ts=-1000:pos=2:nodrop:strategy=10 --lua-desync=fakeddisorder:pos=midsld:tcp_ts=-1000:strategy=10
--lua-desync=hostfakesplit:tcp_ack=-66000:tcp_ts_up:strategy=11
--lua-desync=hostfakesplit:tcp_ack=-66000:tcp_ts_up:ip_autottl=5,3-20:ip6_autottl=5,3-20:strategy=12
--lua-desync=hostfakesplit:tcp_md5:ip_autottl=-1,3-20:ip6_autottl=-1,3-20:strategy=13
--lua-desync=hostfakesplit:disorder_after:tcp_ack=-66000:tcp_ts_up:ip6_dest:strategy=14
--lua-desync=hostfakesplit:disorder_after:tcp_ack=-66000:tcp_ts_up:strategy=15
--lua-desync=multisplit:blob=fake_default_tls:tcp_seq=-3000:pos=2:nodrop:strategy=16 --lua-desync=fakedsplit:pos=midsld:tcp_seq=-3000:strategy=16
--lua-desync=multisplit:blob=fake_default_tls:tcp_seq=-3000:pos=2:nodrop:strategy=17 --lua-desync=fakedsplit:pos=midsld:tcp_seq=-3000:strategy=17
--lua-desync=multisplit:blob=fake_default_tls:tcp_ts=-1000:pos=2:nodrop:strategy=18 --lua-desync=fakeddisorder:pos=endsld:tcp_ts=-1000:strategy=18
--lua-desync=multisplit:blob=fake_default_tls:tcp_ts=-1000:pos=2:nodrop:strategy=19 --lua-desync=fakeddisorder:pos=midsld:tcp_ts=-1000:nofake1:nofake3:strategy=19
--lua-desync=fake:blob=fake_default_tls:tcp_ts=-1000:tcp_ack=-66000:repeats=2:strategy=20 --lua-desync=multisplit:pos=1,midsld:strategy=20
--lua-desync=multisplit:blob=fake_default_tls:tcp_ts=-500:pos=2:nodrop:tcp_ts_up:strategy=21 --lua-desync=fakeddisorder:pos=midsld:tcp_ts=-500:tcp_ts_up:strategy=21
--lua-desync=multisplit:blob=fake_default_tls:tcp_ts=-1000:tcp_seq=-3000:pos=2:nodrop:strategy=22 --lua-desync=fakeddisorder:pos=midsld:tcp_ts=-1000:strategy=22
--lua-desync=multisplit:blob=fake_default_tls:tcp_ts=-1000:pos=2:nodrop:strategy=23 --lua-desync=fakeddisorder:pos=sniext+1:tcp_ts=-1000:strategy=23
--lua-desync=multisplit:blob=fake_default_tls:tcp_ts=-1000:pos=2:nodrop:strategy=24 --lua-desync=fakeddisorder:pos=endsld:tcp_ts=-1000:strategy=24
--lua-desync=fake:blob=fake_default_tls:tcp_ts=-500:repeats=2:strategy=25 --lua-desync=multisplit:pos=1,midsld:strategy=25
--lua-desync=multisplit:seqovl=666:seqovl_pattern=custom:strategy=26 --lua-desync=multidisorder:pos=1,midsld:strategy=26
--lua-desync=hostfakesplit:host=ozon.ru:tcp_ts=-1000:tcp_md5:repeats=4:strategy=27
--lua-desync=multidisorder:pos=1,host+2,sld+2,sld+5,sniext+1,sniext+2,endhost-2:seqovl=1:strategy=28
--lua-desync=send:repeats=2:strategy=29 --lua-desync=syndata:blob=google_www:strategy=29 --lua-desync=multisplit:seqovl=211:seqovl_pattern=tls5:strategy=29
--lua-desync=multisplit:blob=fake_default_tls:tcp_ts=-1000:pos=2:nodrop:ip_autottl=2,3-20:ip6_autottl=2,3-20:strategy=30 --lua-desync=fakedsplit:pos=midsld:tcp_ts=-1000:ip_autottl=2,3-20:ip6_autottl=2,3-20:strategy=30

--new

#Стратегии для YT
--qnum 300 --filter-tcp=443 --filter-l7=tls
--hostlist=/opt/zapret2/extra_strats/TCP_YT_list.txt
--hostlist-exclude=/opt/zapret2/lists/netrogat.txt
--payload=tls_client_hello,http_req,http_reply,unknown,tls_server_hello
--out-range=-s34228
--in-range=-s32768 --lua-desync=circular_locked:key=1
--import=z2r_tcp_tls_common

--new

